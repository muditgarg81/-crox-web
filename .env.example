# Optional: enables the contact form to send email via Resend (https://resend.com).
# Without it, submissions are logged server-side instead of emailed.
RESEND_API_KEY=

# Required for Intralink (employee portal): Postgres connection string.
# Get one for free at https://neon.tech.
DATABASE_URL=

# Required for Intralink: random secret used to sign session tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required for Intralink's Documents feature (file uploads).
# Auto-provided when Vercel Blob storage is enabled on your Vercel project;
# for local dev, run `vercel env pull` after enabling it, or set manually.
BLOB_READ_WRITE_TOKEN=

# Optional: overrides for the bootstrap admin account created by `npm run db:seed`.
# If unset, email defaults to admin@croxoilandgas.com and a random password is generated.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Required for Intralink's mobile OTP login/signup. From the Twilio Console;
# TWILIO_VERIFY_SERVICE_SID is created once via the Verify product (not a phone number).
# Without these set, the "Mobile OTP" tab shows an error and email/password still works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
